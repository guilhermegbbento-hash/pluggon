# Copie para .env.local e preencha. Nunca versione valores reais.

# Google Places / Geocoding (servidor)
GOOGLE_MAPS_API_KEY=

# CARTO basemaps — mapas do app e, sem a variável abaixo, também gravada em todo HTML exportado.
# ⚠ NÃO restringir por domínio nem rotacionar enquanto houver relatório em campo (ver README).
NEXT_PUBLIC_CARTO_API_KEY=

# Opcional: chave só para os HTML exportados. Ao separar, a chave ATUAL vem para cá
# (continua intocável) e uma chave NOVA vai para NEXT_PUBLIC_CARTO_API_KEY.
NEXT_PUBLIC_CARTO_EXPORT_API_KEY=

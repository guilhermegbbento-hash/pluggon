# Copie para .env.local e preencha. Nunca versione valores reais.

# Google Places / Geocoding (servidor)
GOOGLE_MAPS_API_KEY=

# OpenChargeMap (opcional — reforço de potência dos eletropostos)
OPENCHARGEMAP_API_KEY=

# CARTO basemaps — mapas DENTRO do app web. Pode ser restrita por domínio.
NEXT_PUBLIC_CARTO_API_KEY=

# CARTO basemaps — gravada em todo HTML ENTREGUE A CLIENTE (aberto de file://).
# ⚠ NUNCA restringir por domínio nem rotacionar/revogar: quebra todo relatório já enviado.
# Leia README.md, seção "HTML exportado para cliente".
NEXT_PUBLIC_CARTO_EXPORT_API_KEY=
